generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

enum BookingType {
  ONLINE
  OFFLINE
}

enum InquiryStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

model User {
  id              String   @id @default(uuid())
  clerkUserId     String   @unique
  email           String   @unique
  name            String?
  imageUrl        String?
  phone           String?
  role            Role     @default(USER)
  
  managedBranchId String?
  managedBranch   Branch?  @relation("BranchManager", fields: [managedBranchId], references: [id], onDelete: SetNull)
  
  bookings        Booking[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Branch {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  city            String
  state           String
  address         String
  phone           String
  email           String
  description     String?
  images          String[]  @default([])
  amenities       String[]  @default([])
  pricePerSlot    Float     @default(0)
  mapUrl          String?
  instagramHandle String?
  whatsapp        String?
  upiId           String?   @default("9762486649@ybl")
  isActive        Boolean   @default(true)
  
  managers        User[]    @relation("BranchManager")
  halls           Hall[]
  slots           Slot[]
  packages        Package[]
  addOns          AddOn[]
  bookings        Booking[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Hall {
  id        String    @id @default(uuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String    // e.g. "Hall 1", "Hall 2 (VIP Lounge)"
  capacity  Int?      @default(15)
  isActive  Boolean   @default(true)

  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Package {
  id            String   @id @default(uuid())
  branchId      String?  // null = Global Admin Package; set = Branch Specific Package
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  badge         String   @default("Standard")
  originalPrice Float
  offerPrice    Float
  features      String[] @default([])
  isGlobal      Boolean  @default(true)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AddOn {
  id        String   @id @default(uuid())
  branchId  String?  // null = Global Admin AddOn; set = Branch Specific AddOn
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  isGlobal  Boolean  @default(true)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slot {
  id            String             @id @default(uuid())
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title         String
  startTime     String
  endTime       String
  price         Float
  isActive      Boolean            @default(true)
  
  bookings      Booking[]
  disabledDates SlotDisabledDate[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model SlotDisabledDate {
  id        String   @id @default(uuid())
  slotId    String
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date      String
  createdAt DateTime @default(now())

  @@unique([slotId, date])
}

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hallId        String?
  hall          Hall?         @relation(fields: [hallId], references: [id], onDelete: SetNull)
  hallName      String?
  slotId        String?
  slot          Slot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  slotTitle     String?
  customerName  String
  customerEmail String
  customerPhone String
  bookingDate   DateTime
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  bookingStatus BookingStatus @default(PENDING)
  bookingType   BookingType   @default(ONLINE)
  transactionId String?
  notes         String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model FranchiseInquiry {
  id               String        @id @default(uuid())
  name             String
  email            String
  phone            String
  city             String
  investmentBudget String
  message          String?
  status           InquiryStatus @default(PENDING)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}
